<Window x:Class="LabyrinthGame.RulesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
        xmlns:local="clr-namespace:LabyrinthGame"
         Title="RulesWindow" Height="600" Width="800"
             WindowState="Normal" WindowStartupLocation="CenterScreen">

    <Window.DataContext>
        <local:RulesViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <ImageBrush x:Key="1Background" ImageSource="C:\repos\LabyrinthGame\Resources\Images\1Background.jpeg"/>
        <ImageBrush x:Key="2Background" ImageSource="C:\repos\LabyrinthGame\Resources\Images\2Background.jpeg"/>
        <ImageBrush x:Key="BlurredBackground" ImageSource="C:\repos\LabyrinthGame\Resources\Images\blurredBackground.jpeg"/>
        <ImageBrush x:Key="CloseBrush" ImageSource="C:\repos\LabyrinthGame\Resources\Images\close.png"/>
        <ImageBrush x:Key="CongratsBrush" ImageSource="C:\repos\LabyrinthGame\Resources\Images\congrats.png"/>
        <ImageBrush x:Key="DeleteBrush" ImageSource="C:\repos\LabyrinthGame\Resources\Images\delete.png"/>
        <ImageBrush x:Key="dSpaceBrush" ImageSource="C:\repos\LabyrinthGame\Resources\Images\dSpace.png"/>
        <ImageBrush x:Key="dSpaceKarteBrush" ImageSource="C:\repos\LabyrinthGame\Resources\Images\dSpaceKarte.jpeg"/>
        <ImageBrush x:Key="ExitBrush" ImageSource="C:\repos\LabyrinthGame\Resources\Images\exit.png"/>
        <ImageBrush x:Key="HomeBrush" ImageSource="C:\repos\LabyrinthGame\Resources\Images\home.png"/>
        <ImageBrush x:Key="MinusBrush" ImageSource="C:\repos\LabyrinthGame\Resources\Images\minus.png"/>
        <ImageBrush x:Key="PlusBrush" ImageSource="C:\repos\LabyrinthGame\Resources\Images\plus.png"/>
        <ImageBrush x:Key="SaveBrush" ImageSource="C:\repos\LabyrinthGame\Resources\Images\save.png"/>
        <ImageBrush x:Key="SettingsBrush" ImageSource="C:\repos\LabyrinthGame\Resources\Images\settings.png"/>
        <ImageBrush x:Key="TrophyBrush" ImageSource="C:\repos\LabyrinthGame\Resources\Images\trophy.png"/>
        <ImageBrush x:Key="VolumeBrush" ImageSource="C:\repos\LabyrinthGame\Resources\Images\volume.png"/>
        <ImageBrush x:Key="WinnerBrush" ImageSource="C:\repos\LabyrinthGame\Resources\Images\winner.png"/>
        <ImageBrush x:Key="LossBrush" ImageSource="C:\repos\LabyrinthGame\Resources\Images\loss.jpg"/>
        <ImageBrush x:Key="DrawBrush" ImageSource="C:\repos\LabyrinthGame\Resources\Images\draw.jpg"/>

        <Style x:Key="BaseButtonStyle" TargetType="Button">
            <Setter Property="FontSize" Value="55"/>
            <Setter Property="FontWeight" Value="ExtraBold"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ImageButtonStyle" BasedOn="{StaticResource BaseButtonStyle}" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0">
                            <Image Source="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                     To="0.9" Duration="0:0:0.1"/>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                     To="0.9" Duration="0:0:0.1"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                     To="1.0" Duration="0:0:0.1"/>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                     To="1.0" Duration="0:0:0.1"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TextButtonStyle" BasedOn="{StaticResource BaseButtonStyle}" TargetType="Button">
            <Setter Property="Background" Value="#111B4A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0" CornerRadius="50">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TextButtonWithEffectStyle" BasedOn="{StaticResource TextButtonStyle}" TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0" CornerRadius="50">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                     To="0.9" Duration="0:0:0.1"/>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                     To="0.9" Duration="0:0:0.1"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                     To="1.0" Duration="0:0:0.1"/>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                     To="1.0" Duration="0:0:0.1"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Window.Background>
        <ImageBrush  ImageSource="C:\repos\LabyrinthGame\Resources\Images\2Background.jpeg"/>
    </Window.Background>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Button Grid.Row="0" Grid.Column="8"
                Command="{Binding TrophyCommand}"
                CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                Width="85" Height="85"
                Style="{StaticResource ImageButtonStyle}"
                Background="{StaticResource TrophyBrush}">
        </Button>

        <Button Grid.Row="0" Grid.Column="0"
                Style="{StaticResource ImageButtonStyle}"
                Background="{StaticResource dSpaceBrush}"
                IsHitTestVisible="False" Margin="0,0,5,30">
        </Button>

        <Button Grid.Row="0" Grid.Column="1"
                Command="{Binding HomeCommand}"
                CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                Width="85" Height="85"
                Style="{StaticResource ImageButtonStyle}"
                Background="{StaticResource HomeBrush}">
        </Button>

        <Button Grid.Row="9" Grid.Column="9"
                Command="{Binding ExitCommand}"
                CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                Width="85" Height="85"
                Style="{StaticResource ImageButtonStyle}"
                Background="{StaticResource ExitBrush}">
        </Button>

        <Button Grid.Row="9" Grid.Column="0"
                Command="{Binding CloseCommand}"
                CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                Width="85" Height="85"
                Style="{StaticResource ImageButtonStyle}"
                Background="{StaticResource CloseBrush}">
        </Button>

        <Border Grid.Row="0" Grid.Column="1" Grid.RowSpan="10" Grid.ColumnSpan="8"
                CornerRadius="50" Background="#111B4A" 
                HorizontalAlignment="Center" VerticalAlignment="Center" 
                Margin="0" Padding="10" MaxWidth="1000">
            <Border BorderBrush="White" BorderThickness="5" CornerRadius="50">
                <TextBlock TextWrapping="Wrap" TextAlignment="Center" FontSize="30" Padding="10" Foreground="White">
                    -The maximum number of players is 2.<LineBreak/>
                    -The player who has the first turn of the round is determined randomly.<LineBreak/>
                    -The goal of the game is to create paths that connect two identical treasures in a maze.<LineBreak/> 
                    -Sometimes it is possible to create a connection of paths that contain two or more treasures. <LineBreak/>
                    -The player takes the card or cards with which the path connecting the same treasures in the maze was created.<LineBreak/> 
                    -The player can bring the chosen card to the playing field and try to see if the path has been created.<LineBreak/> 
                    -When a player places a card, the position of the card can no longer be changed.<LineBreak/>
                    -A map cannot be placed unless it is connected by a track.<LineBreak/>
                    -At the end of their turn, the player draws a new card from the deck so that there are always two cards in their hand.<LineBreak/> 
                    -To turn the card over - click the right mouse button.<LineBreak/>
                    -To move the card - hold down the left mouse button, to put the card down - release the left mouse button.<LineBreak/>
                    -The game ends as soon as the deck of cards is used up and all players use their cards.<LineBreak/>
                    -Whoever has more cards in the end wins the game.<LineBreak/>
                </TextBlock>
            </Border>
        </Border>

    </Grid>

</Window>