<Window x:Class="LabyrinthGame.ExitWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
        xmlns:local="clr-namespace:LabyrinthGame"
         Title="ChangeProfileWindow" Height="1080" Width="1920"
        WindowState="Normal" WindowStartupLocation="CenterScreen">

    <Window.DataContext>
        <local:ChangeProfileViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <ImageBrush x:Key="1Background" ImageSource="C:\repos\LabyrinthGame\Resources\Images\1Background.jpeg"/>
        <ImageBrush x:Key="2Background" ImageSource="C:\repos\LabyrinthGame\Resources\Images\2Background.jpeg"/>
        <ImageBrush x:Key="BlurredBackground" ImageSource="C:\repos\LabyrinthGame\Resources\Images\blurredBackground.jpeg"/>
        <ImageBrush x:Key="CloseBrush" ImageSource="C:\repos\LabyrinthGame\Resources\Images\close.png"/>
        <ImageBrush x:Key="CongratsBrush" ImageSource="C:\repos\LabyrinthGame\Resources\Images\congrats.png"/>
        <ImageBrush x:Key="DeleteBrush" ImageSource="C:\repos\LabyrinthGame\Resources\Images\delete.png"/>
        <ImageBrush x:Key="dSpaceBrush" ImageSource="C:\repos\LabyrinthGame\Resources\Images\dSpace.png"/>
        <ImageBrush x:Key="dSpaceKarteBrush" ImageSource="C:\repos\LabyrinthGame\Resources\Images\dSpaceKarte.jpeg"/>
        <ImageBrush x:Key="ExitBrush" ImageSource="C:\repos\LabyrinthGame\Resources\Images\exit.png"/>
        <ImageBrush x:Key="HomeBrush" ImageSource="C:\repos\LabyrinthGame\Resources\Images\home.png"/>
        <ImageBrush x:Key="MinusBrush" ImageSource="C:\repos\LabyrinthGame\Resources\Images\minus.png"/>
        <ImageBrush x:Key="PlusBrush" ImageSource="C:\repos\LabyrinthGame\Resources\Images\plus.png"/>
        <ImageBrush x:Key="SaveBrush" ImageSource="C:\repos\LabyrinthGame\Resources\Images\save.png"/>
        <ImageBrush x:Key="SettingsBrush" ImageSource="C:\repos\LabyrinthGame\Resources\Images\settings.png"/>
        <ImageBrush x:Key="TrophyBrush" ImageSource="C:\repos\LabyrinthGame\Resources\Images\trophy.png"/>
        <ImageBrush x:Key="VolumeBrush" ImageSource="C:\repos\LabyrinthGame\Resources\Images\volume.png"/>
        <ImageBrush x:Key="WinnerBrush" ImageSource="C:\repos\LabyrinthGame\Resources\Images\winner.png"/>
        <ImageBrush x:Key="LossBrush" ImageSource="C:\repos\LabyrinthGame\Resources\Images\loss.jpg"/>
        <ImageBrush x:Key="DrawBrush" ImageSource="C:\repos\LabyrinthGame\Resources\Images\draw.jpg"/>

        <Style x:Key="BaseButtonStyle" TargetType="Button">
            <Setter Property="FontSize" Value="55"/>
            <Setter Property="FontWeight" Value="ExtraBold"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ImageButtonStyle" BasedOn="{StaticResource BaseButtonStyle}" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0">
                            <Image Source="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                               To="0.9" Duration="0:0:0.1"/>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                               To="0.9" Duration="0:0:0.1"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                               To="1.0" Duration="0:0:0.1"/>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                               To="1.0" Duration="0:0:0.1"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TextButtonStyle" BasedOn="{StaticResource BaseButtonStyle}" TargetType="Button">
            <Setter Property="Background" Value="#111B4A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0" CornerRadius="50">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TextButtonWithEffectStyle" BasedOn="{StaticResource TextButtonStyle}" TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0" CornerRadius="50">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                               To="0.9" Duration="0:0:0.1"/>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                               To="0.9" Duration="0:0:0.1"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                               To="1.0" Duration="0:0:0.1"/>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                               To="1.0" Duration="0:0:0.1"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LargeRadioButton" TargetType="RadioButton">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <BulletDecorator Background="Transparent">
                            <BulletDecorator.Bullet>
                                <Grid Width="30" Height="30">
                                    <Ellipse Fill="White" Stroke="Black" StrokeThickness="2"/>
                                    <Ellipse x:Name="Dot" Width="15" Height="15" Fill="Black" Visibility="Hidden"/>
                                </Grid>
                            </BulletDecorator.Bullet>
                            <ContentPresenter VerticalAlignment="Center" Margin="5,0,0,0"/>
                        </BulletDecorator>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Dot" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Window.Background>
        <ImageBrush ImageSource="C:\repos\MPM2024_AD_Labyrinth\Das Verrückte Labyrinth\Pictures\2Background.jpeg"/>
    </Window.Background>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Button Grid.Row="0" Grid.Column="8"
                Command="{Binding TrophyCommand}"
                CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                Width="85" Height="85"
                Style="{StaticResource ImageButtonStyle}"
                Background="{StaticResource TrophyBrush}">
        </Button>

        <Button Grid.Row="0" Grid.Column="0"
                Margin="0,0,5,30"
                Style="{StaticResource ImageButtonStyle}"
                Background="{StaticResource dSpaceBrush}"
                IsHitTestVisible="False">
        </Button>

        <Button Grid.Row="0" Grid.Column="1"
                Command="{Binding HomeCommand}"
                CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                Width="85" Height="85"
                Style="{StaticResource ImageButtonStyle}"
                Background="{StaticResource HomeBrush}">
        </Button>

        <Button Grid.Row="9" Grid.Column="9"
                Command="{Binding ExitCommand}"
                CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                Width="85" Height="85"
                Style="{StaticResource ImageButtonStyle}"
                Background="{StaticResource ExitBrush}">
        </Button>

        <Button Grid.Row="0" Grid.Column="9"
                Command="{Binding SettingsCommand}"
                CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                Width="85" Height="85"
                Style="{StaticResource ImageButtonStyle}"
                Background="{StaticResource SettingsBrush}">
        </Button>

        <Button Grid.Row="9" Grid.Column="0"
                Command="{Binding SaveCommand}"
                CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                Width="85" Height="85"
                Style="{StaticResource ImageButtonStyle}"
                Background="{StaticResource SaveBrush}">
        </Button>

        <Button Grid.Row="4" Grid.Column="4"
                Command="{Binding DeleteProfile1Command}"
                CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                Width="35" Height="35"
                Style="{StaticResource ImageButtonStyle}"
                Background="{StaticResource DeleteBrush}">
        </Button>

        <Button Grid.Row="6" Grid.Column="4"
                Command="{Binding DeleteProfile2Command}"
                CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                Width="35" Height="35"
                Style="{StaticResource ImageButtonStyle}"
                Background="{StaticResource DeleteBrush}">
        </Button>

        <Button Grid.Row="8" Grid.Column="4"
                Command="{Binding DeleteProfile3Command}"
                CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                Width="35" Height="35"
                Style="{StaticResource ImageButtonStyle}"
                Background="{StaticResource DeleteBrush}">
        </Button>

        <Border Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="5"  Grid.RowSpan="2"
                CornerRadius="10" Background="#111B4A" 
                HorizontalAlignment="Center" VerticalAlignment="Top" Height="80" Width="350">
            <Border BorderBrush="White" BorderThickness="5" CornerRadius="10">
                <Button Content="Select your profile" 
                        IsHitTestVisible="False"
                        Style="{StaticResource TextButtonStyle}"
                        FontSize="34">
                </Button>
            </Border>
        </Border>


        <!--<Image Grid.Row="1" Grid.Column="4" Grid.ColumnSpan="4" Grid.RowSpan="3"
               Source="{Binding ProfileImage}" Stretch="Uniform"/>-->

        <StackPanel Orientation="Horizontal" Grid.Row="4" Grid.Column="2" Grid.ColumnSpan="3">
            <Border CornerRadius="10" Background="#111B4A" 
                    HorizontalAlignment="Center" VerticalAlignment="Center" Height="70" Width="250">
                <Border BorderBrush="White" BorderThickness="5" CornerRadius="10">
                    <Button Content="{Binding Nickname1}" 
                            IsHitTestVisible="False"
                            Style="{StaticResource TextButtonStyle}"
                            FontSize="28">
                    </Button>
                </Border>
            </Border>
            <RadioButton GroupName="Profiles" VerticalAlignment="Center" Margin="5" 
                         Style="{StaticResource LargeRadioButton}" Tag="Nickname1"
                         IsChecked="{Binding IsProfile1Checked}"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" Grid.Row="6" Grid.Column="2" Grid.ColumnSpan="3">
            <Border CornerRadius="10" Background="#111B4A" 
                    HorizontalAlignment="Center" VerticalAlignment="Center" Height="70" Width="250">
                <Border BorderBrush="White" BorderThickness="5" CornerRadius="10">
                    <Button Content="{Binding Nickname2}" 
                            IsHitTestVisible="False"
                            Style="{StaticResource TextButtonStyle}"
                            FontSize="28">
                    </Button>
                </Border>
            </Border>
            <RadioButton GroupName="Profiles" VerticalAlignment="Center" Margin="5" 
                         Style="{StaticResource LargeRadioButton}" Tag="Nickname2" 
                         IsChecked="{Binding IsProfile2Checked}"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" Grid.Row="8" Grid.Column="2" Grid.ColumnSpan="3">
            <Border CornerRadius="10" Background="#111B4A" 
                    HorizontalAlignment="Center" VerticalAlignment="Center" Height="70" Width="250">
                <Border BorderBrush="White" BorderThickness="5" CornerRadius="10">
                    <Button Content="{Binding Nickname3}" 
                            IsHitTestVisible="False"
                            Style="{StaticResource TextButtonStyle}"
                            FontSize="28">
                    </Button>
                </Border>
            </Border>
            <RadioButton GroupName="Profiles" VerticalAlignment="Center" Margin="5" 
                         Style="{StaticResource LargeRadioButton}" Tag="Nickname3"
                         IsChecked="{Binding IsProfile3Checked}"/>
        </StackPanel>

        <Border Grid.Row="4" Grid.Column="5" Grid.ColumnSpan="5"  Grid.RowSpan="2"  
                CornerRadius="10" BorderBrush="White" BorderThickness="5" 
                Background="#111B4A" HorizontalAlignment="Center" VerticalAlignment="Center" 
                Height="80" Width="350">
            <TextBox TextWrapping="Wrap" Text="{Binding NewNickname, UpdateSourceTrigger=PropertyChanged}" 
                     Foreground="Red" Background="Transparent" TextAlignment="Center" 
                     FontSize="34" CaretBrush="White">
            </TextBox>
        </Border>

        <Border Grid.Row="6" Grid.Column="5" Grid.ColumnSpan="5"  Grid.RowSpan="2"  
                CornerRadius="10" Background="#111B4A" 
                HorizontalAlignment="Center" VerticalAlignment="Top" Height="80" Width="350">
            <Border BorderBrush="White" BorderThickness="5" CornerRadius="10">
                <Button Content="Create your profile" 
                        Command="{Binding CreateProfileCommand}"
                        Style="{StaticResource TextButtonWithEffectStyle}"
                        FontSize="34">
                </Button>
            </Border>
        </Border>

    </Grid>
</Window>